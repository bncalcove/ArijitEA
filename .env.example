# Everything here is optional. Without it, the app shows a first-run setup page
# (setup code printed in the log) and keys can be entered in Settings → Connections.
PORT=3000
DASHBOARD_PASSWORD=
SESSION_SECRET=
DATA_DIR=
# AI_PROVIDER: auto (API key if set, else Claude Code login), api, claude-cli, off
AI_PROVIDER=auto
CLAUDE_CLI_PATH=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=
NOTES_EMAIL_TAG=[EA-NOTES]
WHATSAPP_ENDPOINT=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_TO_NUMBER=
TZ=Asia/Kolkata
